# TruthLens monitoring stack configuration.
# Copy this file to .env inside deployment/ (next to docker-compose.monitoring.yml)
# and set values before running:
#   docker compose -f docker-compose.monitoring.yml up -d

# Grafana admin password. Defaults to "admin" when unset — set a strong value
# on any shared deployment.
GRAFANA_ADMIN_PASSWORD=change-me
