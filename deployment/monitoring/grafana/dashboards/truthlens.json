{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(truthlens_http_requests_total[5m]))", "legendFormat": "all" },
        { "expr": "sum by (path) (rate(truthlens_http_requests_total[5m]))", "legendFormat": "{{path}}" }
      ]
    },
    {
      "title": "Error rate (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(rate(truthlens_http_errors_total[5m])) / sum(rate(truthlens_http_requests_total[5m]))",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "title": "p95 latency (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(truthlens_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "title": "Database up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "truthlens_database_up", "legendFormat": "db" }]
    },
    {
      "title": "Database ping latency (ms)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "decimals": 2 },
        "overrides": []
      },
      "targets": [
        { "expr": "truthlens_database_ping_latency_seconds * 1000", "legendFormat": "ping" }
      ]
    },
    {
      "title": "Uptime (days)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "d", "decimals": 2 },
        "overrides": []
      },
      "targets": [{ "expr": "truthlens_uptime_seconds / 86400", "legendFormat": "uptime" }]
    },
    {
      "title": "Environment",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "truthlens_environment", "legendFormat": "0=dev 1=test 2=prod" }]
    },
    {
      "title": "Inferences by prediction",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (prediction) (rate(truthlens_ai_inferences_total[5m]))",
          "legendFormat": "{{prediction}}"
        }
      ]
    },
    {
      "title": "Low-confidence rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(truthlens_ai_low_confidence_total[5m])", "legendFormat": "low-conf" }
      ]
    },
    {
      "title": "AI errors rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        { "expr": "rate(truthlens_ai_errors_total[5m])", "legendFormat": "ai-errors" }
      ]
    },
    {
      "title": "Model info",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        { "expr": "truthlens_ai_model_info", "format": "table", "instant": true }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["truthlens", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "TruthLens AI — Platform Overview",
  "uid": "truthlens-platform",
  "version": 1
}
