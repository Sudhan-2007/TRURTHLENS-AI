# ---- TruthLens AI backend configuration ----
# Copy to .env and fill in real values. NEVER commit .env.

# Runtime environment: development | testing | production
ENVIRONMENT=development

# MongoDB connection. DATABASE_URL and MONGODB_URI are interchangeable aliases.
# Local:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=truthlens

# MongoDB Atlas URI (replace with your real connection string):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI engine
# Override the DistilBERT checkpoint directory (e.g. a mounted volume in prod).
# AI_MODEL_PATH=/app/ai-engine/models/distilbert
# Model backend: "baseline" or "distilbert".
# TRUTHLENS_MODEL_BACKEND=distilbert

# Optional API keys for external verification sources (comma separated).
# SOURCE_API_KEYS=key1,key2
