# Base URL the browser uses to reach the backend API.
# Local development (Vite dev server -> local FastAPI):
VITE_API_BASE_URL=http://localhost:8000

# Production: when the frontend is served by nginx which proxies /api to the
# backend, omit this variable (or set it to an empty value) so the browser
# talks to the same origin:
# VITE_API_BASE_URL=
