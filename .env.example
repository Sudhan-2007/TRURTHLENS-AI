# TruthLens AI deployment configuration.
# Copy this file to .env at the repository root (gitignored) and fill in real
# values before running `docker compose up -d`.

# Runtime environment: development | testing | production
ENVIRONMENT=production
DEBUG=false

# Auth secret: strong random value >= 32 chars (required in production).
# Production startup FAILS until this is replaced with a real random value.
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me

# Database. Defaults to the compose-managed MongoDB service (mongodb:27017).
# For MongoDB Atlas set DATABASE_URL to your connection string:
# DATABASE_URL=mongodb+srv://<user>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
DATABASE_URL=mongodb://mongodb:27017
MONGODB_DB=truthlens

# CORS origins for browser clients (comma separated).
CORS_ORIGINS=http://localhost

# AI engine
TRUTHLENS_MODEL_BACKEND=distilbert
AI_MODEL_PATH=/app/ai-engine/models/distilbert
# SOURCE_API_KEYS=key1,key2

# Frontend (nginx). Leave VITE_API_BASE_URL empty for same-origin proxying, or
# set an absolute URL when the API lives on another origin.
VITE_API_BASE_URL=

# Host port mapped to the frontend container.
HTTP_PORT=80
